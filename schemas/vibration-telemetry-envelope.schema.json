{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garage-simulation.local/schemas/vibration-telemetry-envelope.schema.json",
  "title": "Three-axis Vibration Telemetry Envelope",
  "description": "Unified telemetry envelope specialized for 100-sample three-axis vibration batches.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "garageId",
    "areaId",
    "deviceId",
    "sensorId",
    "pointCode",
    "sensorType",
    "sourceTime",
    "seq",
    "status",
    "quality",
    "actionStage",
    "source",
    "scenarioId",
    "data"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "messageId": {
      "type": "string",
      "pattern": "^MSG-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "garageId": {"type": "string", "minLength": 1},
    "areaId": {"type": "string", "minLength": 1},
    "deviceId": {"type": "string", "minLength": 1},
    "sensorId": {"type": "string", "minLength": 1},
    "pointCode": {"const": "LIFT_MECHANISM_VIBRATION"},
    "sensorType": {"const": "vibration"},
    "sourceTime": {"type": "string", "format": "date-time"},
    "seq": {"type": "integer", "minimum": 0},
    "status": {
      "type": "string",
      "enum": ["normal", "warning", "critical", "fault", "offline", "unknown"]
    },
    "quality": {
      "type": "string",
      "enum": ["valid", "invalid", "missing", "delayed", "duplicated", "out_of_range"]
    },
    "actionStage": {
      "enum": ["idle", "starting", "lifting", "shifting", "arriving", "stopped", "fault"]
    },
    "source": {"const": "simulator"},
    "scenarioId": {"type": "string", "minLength": 1},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "sampleRateHz", "sampleCount", "samples", "features"],
      "properties": {
        "unit": {"const": "m/s2"},
        "sampleRateHz": {"type": "integer", "minimum": 1, "default": 100},
        "sampleCount": {"type": "integer", "minimum": 1, "default": 100},
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "z"],
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"},
              "z": {"type": "number"}
            }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["xRms", "yRms", "zRms", "peak"],
          "properties": {
            "xRms": {"type": "number", "minimum": 0},
            "yRms": {"type": "number", "minimum": 0},
            "zRms": {"type": "number", "minimum": 0},
            "peak": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
